         <dc:title>
            <rdf:Alt>
               <rdf:li xml:lang="x-default">Does 10-Hz Cathodal Oscillating Current of the Parieto-Occipital Lobe Modulate Target Detection?</rdf:li>
            </rdf:Alt>
         </dc:title>
         <dc:creator>
            <rdf:Seq>
               <rdf:li>Sarah S. Sheldon</rdf:li>
            </rdf:Seq>
         </dc:creator>
         <dc:description>
            <rdf:Seq>
               <rdf:li xml:lang="x-default">The phase of alpha (8â€“12Hz) brain oscillations have been associated with moment to moment changes in visual attention and awareness.</rdf:li>
               <rdf:li>The phase of alpha (8â€“12Hz) brain oscillations have been associated with moment to moment changes in visual attention and awareness.</rdf:li>
